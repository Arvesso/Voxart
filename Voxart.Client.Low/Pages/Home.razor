@page "/"

@inject BrowserStorage Storage
@inject ApiInterop Api

@inject ISnackbar sn

<PageTitle>Voxart</PageTitle>

<MudText Typo="Typo.h1" Style="margin-top: 14%;" Color="Color.Primary">
    ТВОЙ ЦИФРОВОЙ
</MudText>

<MudText Typo="Typo.h1">
    АВАТАР
</MudText>

<MudText Typo="Typo.h6">
    креативный компаньон на базе искусственного интеллекта
</MudText>

<MudButton EndIcon="@Icons.Material.Filled.ArrowForward" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Class="mt-6" Href="/account/register">Попробовать</MudButton>

@* <MudStack Row> СДЕЛАТЬ ТАКОЕ В ХЕДЕРЕ
    <MudRating Size="@Size.Small" SelectedValue="@context.Item.Rating" />
    <MudButton Size="@Size.Small" Variant="@Variant.Filled" Color="@Color.Primary">Hire</MudButton>
</MudStack> *@

@code {
    protected override async Task OnInitializedAsync()
    {
        var client = await Storage.GetKey(BrowserStorage.Keys.KeyClient);

        if (client is null)
        {
            sn.Add("client null");

            var newClient = await Api.CreateClient();

            if (newClient is not null)
            {
                await Storage.SetKey(BrowserStorage.Keys.KeyClient, newClient);
            }
        }
    }
}
